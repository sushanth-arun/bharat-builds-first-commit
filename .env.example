# PRAAPTI AI - Local Environment Variables (100% Local / Open Source)

# OpenSearch Instance (Optional)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_NAME=praapti-schemes

# Cedar Policy Engine
CEDAR_POLICY_PATH=backend/policies/auth.cedar

# Strands Agent Settings
AGENT_ENV=development
LOG_LEVEL=INFO

# ==============================================================================
# LLM Providers (Optional for Real-time Generative Chatbot)
# If provided, PRAAPTI AI Agent will invoke Google Gemini / OpenAI / Claude
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
